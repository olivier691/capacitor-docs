# --- Application ---
PORT=3000
NODE_ENV=production
# Adresse publique de l'application (utilisée dans les liens des e-mails)
PUBLIC_URL=https://rendez-vous.mon-entreprise.com
# Chaîne aléatoire longue (ex. : openssl rand -hex 32)
SESSION_SECRET=
TIMEZONE=Africa/Abidjan
ORGANISATION_NAME=Direction Générale — Mon Entreprise
MEETING_LOCATION=Siège, 5e étage — Bureau du PDG
# DB_PATH=./data/rendez-vous.db
# USERS_FILE=./config/users.json

# --- Destinataires des nouvelles demandes : le PDG et son entourage habilité ---
NOTIFY_EMAILS=pdg@mon-entreprise.com,assistante.pdg@mon-entreprise.com,chef.cabinet@mon-entreprise.com

# --- Microsoft 365 / Outlook (Microsoft Graph) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Boîte aux lettres dont l'agenda reçoit les rendez-vous validés (celle du PDG)
GRAPH_CALENDAR_USER=pdg@mon-entreprise.com
# Boîte utilisée pour envoyer les e-mails (par défaut : celle du PDG)
GRAPH_SENDER_USER=rendez-vous@mon-entreprise.com
