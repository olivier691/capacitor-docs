APP_NAME="Rendez-vous PDG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Fuseau horaire des rendez-vous et de l'agenda Outlook
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "microsoft-graph" en production (envoi par Microsoft 365), "log" pour tester
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Boîte Microsoft 365 qui envoie les e-mails (ex. rendez-vous@mon-entreprise.com)
MAIL_FROM_ADDRESS="rendez-vous@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Rendez-vous ---
APPOINTMENTS_ORGANISATION="Direction Générale"
APPOINTMENTS_LOCATION="Siège — Bureau du PDG"
# PDG et entourage habilité : reçoivent chaque nouvelle demande (séparés par des virgules)
APPOINTMENTS_NOTIFY_EMAILS=pdg@example.com,assistante.pdg@example.com

# --- Microsoft 365 / Outlook (Microsoft Graph) ---
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Boîte dont l'agenda reçoit les rendez-vous validés (celle du PDG)
MS_GRAPH_CALENDAR_USER=pdg@example.com
