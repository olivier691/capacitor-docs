{
  "name": "prise-rendez-vous",
  "version": "1.0.0",
  "private": true,
  "description": "Application de prise de rendez-vous avec le PDG : formulaire public, validation par la direction, synchronisation Outlook (Microsoft Graph) et pointage par la sécurité.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "add-user": "node scripts/add-user.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
